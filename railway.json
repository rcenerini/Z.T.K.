{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pip install fastapi uvicorn pydantic httpx jinja2 python-multipart"
  },
  "deploy": {
    "startCommand": "cd interface_excecoes/backend/src && python -m uvicorn main:app --host 0.0.0.0 --port $PORT",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
